# Shared cloud sync (optional). Without these the app runs local-only, exactly
# like before. With them, every device shares one set of stats + player list.
#
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the project's SQL editor
# 3. Project settings -> API: copy the values below
# 4. Set these as environment variables in your host (Vercel / Netlify /
#    Cloudflare Pages / GitHub Actions) and redeploy. For local dev, copy this
#    file to `.env` (it is gitignored).
#
# NOTE: the anon key ships in the built JavaScript. The "MuutaTuloksia" password
# is a client-side gate only — it hides edit controls but is not enforced by the
# database.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
